{
  "private": true,
  "license": "BSD-3-Clause",
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "fix": "npm-run-all --continue-on-error \"fix:*\"",
    "fix:eslint": "next typegen && eslint --fix --max-warnings=0",
    "fix:markdownlint": "markdownlint --dot --fix .",
    "fix:pnpm-dedupe": "pnpm dedupe",
    "fix:prettier": "prettier --write .",
    "postinstall": "husky",
    "lint": "npm-run-all --continue-on-error \"lint:*\"",
    "lint:eslint": "next typegen && eslint --max-warnings=0",
    "lint:markdownlint": "markdownlint --dot .",
    "lint:pnpm-dedupe": "pnpm dedupe --check",
    "lint:prettier": "prettier --check .",
    "lint:tsc": "next typegen && tsc --project .",
    "start": "next start"
  },
  "lint-staged": {
    "**": [
      "suppress-exit-code eslint --fix",
      "suppress-exit-code markdownlint --fix",
      "suppress-exit-code prettier --write"
    ]
  },
  "prettier": "@kachkaev/prettier-config",
  "dependencies": {
    "@vercel/analytics": "2.0.1",
    "hosted-git-info": "10.1.1",
    "lru-cache": "11.5.2",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "tailwind-merge": "3.6.0",
    "url": "0.11.4"
  },
  "devDependencies": {
    "@kachkaev/eslint-config-next": "1.2.0",
    "@kachkaev/markdownlint-config": "1.0.1",
    "@kachkaev/prettier-config": "2.2.1",
    "@next/eslint-plugin-next": "16.3.1",
    "@tailwindcss/postcss": "4.3.3",
    "@tsconfig/next": "2.0.6",
    "@tsconfig/strictest": "2.0.8",
    "@types/hosted-git-info": "3.0.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@typescript/native": "npm:typescript@7.0.2",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "9.39.5",
    "husky": "9.1.7",
    "lint-staged": "17.3.0",
    "markdownlint-cli": "0.49.1",
    "npm-run-all2": "9.0.3",
    "postcss": "8.5.26",
    "prettier": "3.9.6",
    "suppress-exit-code": "4.0.0",
    "tailwindcss": "4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "8.67.0"
  },
  "packageManager": "pnpm@11.22.0",
  "postcss": {
    "plugins": {
      "@tailwindcss/postcss": {}
    }
  }
}
